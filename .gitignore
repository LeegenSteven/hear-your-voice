# ── 凭证（切勿提交）─────────────────────────────────────
.env
.env.*
!.env.example
credentials.json
credentials.*.json

# ── 打包产物 ────────────────────────────────────────────
# 语音识别.zip 是早期代码的打包副本，内含硬编码密钥，切勿入库
语音识别.zip
*.zip

# ── 音频文件与转写产物 ──────────────────────────────────
# 音频体积大且多为本地素材，默认不入库；如需放示例请用 ! 单独放行
*.mp3
*.m4a
*.flac
*.aac
*.wav
!docs/samples/*.wav

# v3.py 预处理生成的中间文件
*_safe.wav

# 讯飞原始返回 JSON（--dump-raw 产物）
*_raw.json

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 模型缓存（Pyannote / Whisper 权重，动辄数 GB）───────
.cache/
models/

# ── 编辑器与系统 ────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
